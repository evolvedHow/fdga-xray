# Dockerfile.alarm — self-contained R image for ALARM SMC ensemble
#
# Mirrors the Modal alarm_image build sequence exactly so behaviour is
# identical whether you run on Modal cloud or this container.
#
# Build:
#   docker build -f Dockerfile.alarm -t fdga-alarm .
#
# First build takes ~15-25 min (R package compilation).
# Subsequent builds are fast — each RUN layer is cached by Docker.

FROM debian:bookworm-slim

# ── System dependencies ───────────────────────────────────────────────────────
RUN apt-get update && apt-get install -y --no-install-recommends \
    # R runtime + compiler
    r-base \
    r-base-dev \
    # Geospatial libs required by the sf R package
    libgdal-dev \
    libgeos-dev \
    libproj-dev \
    libudunits2-dev \
    # Other R package build deps
    libcurl4-openssl-dev \
    libssl-dev \
    libxml2-dev \
    libfontconfig1-dev \
    libuv1-dev \
    # Build tools
    cmake \
    make \
    g++ \
    # Python for Parquet conversion
    python3 \
    python3-pip \
    python3-venv \
    # Utilities
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# ── Python venv ───────────────────────────────────────────────────────────────
RUN python3 -m venv /opt/venv
RUN /opt/venv/bin/pip install --no-cache-dir pyarrow pandas

ENV PATH="/opt/venv/bin:$PATH"

# ── R package repo config ─────────────────────────────────────────────────────
# RSPM first for pre-built bookworm binaries (avoids long C++ compiles).
# Ncpus=4 for parallel make during any source builds.
ENV R_SETUP="options(repos=c(RSPM='https://packagemanager.posit.co/cran/__linux__/bookworm/latest',CRAN='https://cloud.r-project.org'),Ncpus=4L)"

# Each RUN is a separate Docker layer so caching is granular.
# Step 1: libgeos R package (bundles + compiles GEOS C++ — slowest step)
RUN R -e "${R_SETUP}; install.packages('libgeos')"

# Step 2: sf spatial stack
RUN R -e "${R_SETUP}; install.packages(c('sf','lwgeom'), dependencies=TRUE)"

# Step 3: redist SMC sampler (Harvard/MGGG — C++ compilation ~5-10 min)
RUN R -e "${R_SETUP}; install.packages('redist', dependencies=TRUE)"

# Step 4: remaining small packages
RUN R -e "${R_SETUP}; install.packages(c('jsonlite','rmapshaper','geomander'), dependencies=TRUE)"

# ── App scripts ───────────────────────────────────────────────────────────────
WORKDIR /app
COPY scripts/run_alarm_ensemble.R   /app/run_alarm_ensemble.R
COPY scripts/build_chamber_map.R    /app/build_chamber_map.R
COPY scripts/run_house_alarm_docker.sh  /app/run_house_alarm_docker.sh
COPY scripts/concat_alarm_chains.py /app/concat_alarm_chains.py

RUN chmod +x /app/run_house_alarm_docker.sh

# Default entrypoint: run the full house ensemble
ENTRYPOINT ["/app/run_house_alarm_docker.sh"]
